# Cloudflare Pages response headers.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # A children's app: the microphone (speaking) and camera ("Say it right" on a computer) for this origin only,
  # nothing else.
  Permissions-Policy: microphone=(self), camera=(self), geolocation=(), payment=(), usb=(), interest-cohort=()

# Hashed build assets never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and manifest must always be fresh.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
