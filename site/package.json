{
  "name": "wundertutor-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "npm run content:check && astro check && astro build",
    "preview": "astro preview",
    "deploy": "node scripts/require-clean.mjs && npm run build && wrangler pages deploy dist --project-name wundertutor-website --branch main --commit-dirty=false",
    "content:check": "node scripts/check-content.mjs",
    "content:sync": "node scripts/check-content.mjs --write",
    "screenshots": "node scripts/capture-app.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
