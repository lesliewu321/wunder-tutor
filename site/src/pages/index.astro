---
import Base from '@/layouts/Base.astro';
import Pip from '@/components/Pip.astro';
import Screenshot from '@/components/Screenshot.astro';
import { SITE } from '@/lib/site';
import { facts, courseNotes, screens, FAQ } from '@/lib/content';
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'SoftwareApplication', name: SITE.name, url: SITE.appUrl, applicationCategory: 'EducationalApplication', operatingSystem: 'Web browser', description: SITE.description, inLanguage: facts.languages.map(l => l.id), screenshot: screens.map(s => SITE.url + '/screenshots/' + s.id + '.webp'), featureList: ['Pronunciation practice in seven languages', 'Age-adapted lessons', 'Pronunciation Lab', 'Guided conversations', 'English and Mandarin reading practice', 'Optional practice reminders'] },
  { '@type': 'FAQPage', mainEntity: FAQ.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
] };
const steps = [
  { n: '01', title: 'Hear it clearly', text: 'Listen to a word or sentence. Slow it down when you need a little more time.' },
  { n: '02', title: 'Give it a try', text: 'Tap the microphone and speak. With scoring access, get feedback on your pronunciation.' },
  { n: '03', title: 'Practise the next step', text: 'Retry the phrase, work on a sound in the Lab, or come back for a review.' },
];
const bands = [{ name: 'Little', ages: '5–7', text: 'Picture-led prompts, simple words and a playful learning companion.', symbol: '✿' }, { name: 'Junior', ages: '8–11', text: 'Everyday topics, short sentences and a colourful lesson map.', symbol: '✦' }, { name: 'Teen', ages: '12–17', text: 'School, friendships and practical conversations, with a calmer presentation.', symbol: '↗' }, { name: 'Adult', ages: '18+', text: 'Everyday life, travel and work, with foundations to revisit along the way.', symbol: '◎' }];
---
<Base>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Seven languages. Every kind of learner.</p>
        <h1>Pronunciation practice.<br /><span>A little more confidence.</span></h1>
        <p class="hero-lead">Find your voice with Wunder Tutor. Listen, speak and work on the sounds that need another try — with lessons that grow from childhood to adult life.</p>
        <div class="actions"><a class="button button-coral" href={SITE.appUrl}>Start practising <span aria-hidden="true">↗</span></a><a class="text-link" href="#screenshots">Take a look inside <span aria-hidden="true">↓</span></a></div>
        <p class="hero-note">In your browser · Phone, tablet or computer</p>
        <p class="access-note">Beta access: real scoring, cloud voices and photo reading need an invite code or an account with access. <a href="#faq">How access works</a></p>
      </div>
      <div class="hero-visual" aria-label="Actual Wunder Tutor app screens">
        <div class="hero-halo" aria-hidden="true"></div>
        <div class="hero-home"><Screenshot id="learn" alt={screens[0].alt} eager sizes="(max-width: 639px) 180px, 235px" /></div>
        <div class="hero-lesson"><Screenshot id="english-lesson" alt={screens[1].alt} eager sizes="(max-width: 639px) 215px, 265px" /></div>
        <div class="screenshot-tag"><span aria-hidden="true">✦</span> A real look inside the app</div>
      </div>
    </div>
  </section>
  <div class="stats-strip"><dl class="wrap stats"><div><dt>Language courses</dt><dd>{facts.courses.length}</dd></div><div><dt>Course lessons</dt><dd>{facts.totalLessons}</dd></div><div><dt>Age groups</dt><dd>4</dd></div><div><dt>App languages</dt><dd>{facts.languages.length}</dd></div></dl></div>
  <section id="courses" class="section wrap">
    <div class="section-heading"><div><p class="eyebrow">Choose your language</p><h2>A world of things to say.</h2></div><p>Start with familiar words. Move into everyday situations. Switch courses from your Profile as your interests grow.</p></div>
    <div class="course-grid">
      {facts.courses.map(c => <article class={'course-card course-' + c.id}><p class="course-native" lang={c.id === 'zh' ? 'zh-Hans' : c.id}>{courseNotes[c.id].native}</p><h3>{c.name}</h3><p>{courseNotes[c.id].note}</p><span class="course-count">{c.lessons} lessons · {c.conversations} conversations</span></article>)}
      <aside class="language-card"><Pip size={62} /><h3>Learn in your own words.</h3><p>Choose your app language separately from your course.</p><p class="language-list">{facts.languages.map(l => l.label).join(' · ')}</p></aside>
    </div>
    <p class="section-note">Lesson totals count each course lesson once; age-adapted versions and seasonal bonuses are not counted as extra lessons. Course depth varies by language.</p>
  </section>
  <section id="how" class="how-section"><div class="wrap section"><p class="eyebrow">Small steps, spoken out loud</p><h2>Hear it. Try it. Keep going.</h2><div class="step-grid">{steps.map(s => <article><span class="step-number">{s.n}</span><h3>{s.title}</h3><p>{s.text}</p></article>)}</div><p class="section-note">Lessons also include listening choices, reading and sentence-building activities. Available feedback depends on the course and exercise.</p></div></section>
  <section id="screenshots" class="section wrap">
    <div class="section-heading"><div><p class="eyebrow">Inside Wunder Tutor</p><h2>Meet your practice space.</h2></div><p>Real app screens, from your first word to a sound you want to get right. Select a screen to see it at full size.</p></div>
    <div class="screen-grid">{screens.map(s => <figure class="screen-card"><a class="screen-image" href={'/screenshots/' + s.id + '.webp'} target="_blank" rel="noopener" aria-label={'View full-size ' + s.label + ' screenshot (opens in a new tab)'}><Screenshot id={s.id} alt={s.alt} /></a><figcaption><p class="eyebrow">{s.label}</p><h3>{s.title}</h3><p>{s.text}</p></figcaption></figure>)}</div>
    <p class="section-note">Captured from the running local app on 25 September 2026 using a fictional learner. No real learner recordings, photos or scores are shown. Notebook uses original sample text.</p>
  </section>
  <section id="ages" class="ages-section"><div class="wrap section"><div class="section-heading"><div><p class="eyebrow">Room to grow</p><h2>Made for your stage of life.</h2></div><p>Four age groups shape the lesson wording, situations and look of the app. Pick the one that fits you or your child.</p></div><div class="age-grid">{bands.map(b => <article><span class="age-symbol" aria-hidden="true">{b.symbol}</span><p class="eyebrow">Ages {b.ages}</p><h3>{b.name}</h3><p>{b.text}</p></article>)}</div></div></section>
  <section id="privacy" class="section wrap"><div class="privacy-panel"><div><p class="eyebrow">Your voice. Your choices.</p><h2>Know what you’re sharing.</h2><p>Voice and learning data deserve clear explanations. Review the recording choices during setup and change them in Settings.</p><a href="/privacy" class="text-link">Read the privacy notice <span aria-hidden="true">↗</span></a></div><ul><li><b>Recording controls</b><span>Keep replay audio on your device, turn it off or delete it. Scoring sends clips to Azure.</span></li><li><b>A visible contribution choice</b><span>“Help improve Wunder Tutor” starts enabled for new setups. Turn it off if you don’t want the team to retain practice clips for up to 90 days.</span></li><li><b>Optional account sync</b><span>Sync progress and saved text when signed in. Photos and replay audio aren’t part of account sync.</span></li></ul></div></section>
  <section id="faq" class="faq-section"><div class="wrap section faq-layout"><div class="faq-heading"><p class="eyebrow">A few helpful answers</p><h2>Before you say hello.</h2><p>Languages, access, devices and the details of daily practice.</p><Pip size={110} cheer /></div><div class="faq-list">{FAQ.map((f, i) => <details name="faq" id={'faq-' + (i + 1)}><summary>{f.q}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{f.a}</p>{i === 11 && <a href="/privacy" class="text-link">Read the full privacy notice</a>}</div></details>)}</div></div></section>
  <section class="wrap final-section"><div class="final-cta"><p class="eyebrow">Your next word is waiting</p><h2>Make a little time<br />for your voice.</h2><a class="button button-coral" href={SITE.appUrl}>Open Wunder Tutor <span aria-hidden="true">↗</span></a><p>Start in your browser. Explore at your own pace.</p></div></section>
</Base>
