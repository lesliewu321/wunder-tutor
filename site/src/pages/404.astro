---
import Base from '@/layouts/Base.astro';
import Pip from '@/components/Pip.astro';
---
<Base title="Page not found" noindex>
  <section class="mx-auto flex max-w-xl flex-col items-center px-5 py-24 text-center">
    <Pip size={140} />
    <h1 class="mt-6 text-4xl md:text-5xl">Pip can’t hear that page</h1>
    <p class="mt-3 text-lg text-muted-foreground">It may have moved, or the link had a typo.</p>
    <a href="/" class="mt-8 inline-flex h-12 items-center rounded-2xl bg-primary px-6 font-display text-lg font-extrabold text-white shadow-[0_4px_0_#5236d1] transition hover:brightness-110 active:translate-y-1 active:shadow-none">Back to the home page</a>
  </section>
</Base>
