    "zh-tuan2-yuan2": { "text": "团圆", "picture": "👨‍👩‍👧‍👦", "meaning": "the family together again", "kind": "word", "focus": ["zh:t2"], "lang": "zh-CN", "zh": { "hant": "團圓", "py": "tuan2 yuan2" } },
    "zh-zhong1-qiu1-jie2-kuai4-le4-s": { "text": "中秋节快乐！", "picture": "🥮", "meaning": "Happy Mid-Autumn Festival!", "kind": "sentence", "focus": ["zh:t1", "zh:t4"], "lang": "zh-CN", "zh": { "hant": "中秋節快樂！", "py": "zhong1 qiu1 jie2 kuai4 le4" } },
    "zh-jin1-wan3-de5-yue4-liang5-hen3-yuan2-s": { "text": "今晚的月亮很圆。", "picture": "🌕", "meaning": "The moon is very round tonight.", "kind": "sentence", "focus": ["zh:j", "zh:t3"], "lang": "zh-CN", "zh": { "hant": "今晚的月亮很圓。", "py": "jin1 wan3 de5 yue4 liang5 hen3 yuan2" } },
    "zh-wo3-xi3-huan5-chi1-yue4-bing3-s": { "text": "我喜欢吃月饼。", "picture": "🥮", "meaning": "I like eating mooncakes.", "kind": "sentence", "focus": ["zh:t3", "zh:ü"], "lang": "zh-CN", "zh": { "hant": "我喜歡吃月餅。", "py": "wo3 xi3 huan5 chi1 yue4 bing3" } },
    "zh-wo3-men5-yi1-qi3-shang3-yue4-ba5-s": { "text": "我们一起赏月吧！", "picture": "🌕", "meaning": "Let’s admire the moon together!", "kind": "sentence", "focus": ["zh:sh", "zh:t3"], "lang": "zh-CN", "zh": { "hant": "我們一起賞月吧！", "py": "wo3 men5 yi1 qi3 shang3 yue4 ba5" } },
    "zh-ni3-xi3-huan5-shen2-me5-kou3-wei4-de5-yue4-bing3-s": { "text": "你喜欢什么口味的月饼？", "picture": "🥮", "meaning": "Which mooncake flavour do you like?", "kind": "sentence", "focus": ["zh:sh", "zh:t3"], "lang": "zh-CN", "zh": { "hant": "你喜歡什麼口味的月餅？", "py": "ni3 xi3 huan5 shen2 me5 kou3 wei4 de5 yue4 bing3" } },
    "zh-wo3-xi3-huan5-lian2-rong2-yue4-bing3-s": { "text": "我喜欢莲蓉月饼。", "picture": "🥮", "meaning": "I like lotus seed paste mooncakes.", "kind": "sentence", "focus": ["zh:l", "zh:t2"], "lang": "zh-CN", "zh": { "hant": "我喜歡蓮蓉月餅。", "py": "wo3 xi3 huan5 lian2 rong2 yue4 bing3" } },
    "zh-wo3-xi3-huan5-dan4-huang2-yue4-bing3-s": { "text": "我喜欢蛋黄月饼。", "picture": "🥚", "meaning": "I like mooncakes with egg yolk.", "kind": "sentence", "focus": ["zh:t4", "zh:t2"], "lang": "zh-CN", "zh": { "hant": "我喜歡蛋黃月餅。", "py": "wo3 xi3 huan5 dan4 huang2 yue4 bing3" } },
    "zh-chang2-e2-zhu4-zai4-yue4-liang5-shang4-s": { "text": "嫦娥住在月亮上。", "picture": "🌕", "meaning": "Chang’e lives on the moon.", "kind": "sentence", "focus": ["zh:sh", "zh:t2"], "lang": "zh-CN", "zh": { "hant": "嫦娥住在月亮上。", "py": "chang2 e2 zhu4 zai4 yue4 liang5 shang4" } },
    "zh-zhong1-qiu1-jie2-yi1-jia1-ren2-yi1-qi3-shang3-yue4-s": { "text": "中秋节一家人一起赏月。", "picture": "👨‍👩‍👧‍👦", "meaning": "At Mid-Autumn, the whole family admires the moon together.", "kind": "sentence", "focus": ["zh:j", "zh:sh"], "lang": "zh-CN", "zh": { "hant": "中秋節一家人一起賞月。", "py": "zhong1 qiu1 jie2 yi1 jia1 ren2 yi1 qi3 shang3 yue4" } }
