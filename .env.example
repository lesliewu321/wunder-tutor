# Wunder Tutor API proxy (server/index.mjs). Copy to ".env" and fill in.
# .env is git-ignored. These values must never reach the browser bundle —
# do NOT prefix them with VITE_.

# Azure AI Speech resource key (Azure portal -> your Speech resource -> Keys and Endpoint).
AZURE_SPEECH_KEY=
# Azure region of that resource, e.g. westeurope, uksouth, eastus.
AZURE_SPEECH_REGION=
# Optional: only for resources that need the custom-domain endpoint instead of the regional one.
# AZURE_SPEECH_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/stt

# Anthropic API key for the conversation tutor (console.anthropic.com).
ANTHROPIC_API_KEY=
# Claude model used by /api/tutor.
CLAUDE_MODEL=claude-sonnet-5

# Port the proxy listens on (vite.config.ts proxies /api to 8787).
PORT=8787

# --- Teacher voice: Gemini Live API (native audio) -------------------------------------------
# Create a key at https://aistudio.google.com/apikey (use a project dedicated to Wunder Tutor so
# quota, billing and key rotation stay separate from your other apps).
# Only lesson text is sent to Google — never a child's voice.
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_TTS_VOICE=Kore          # Kore, Puck, Charon, Fenrir, Aoede, Leda, Orus, Zephyr

# --- Family accounts: Supabase (project "Wunder Tutor") --------------------------------------
# Public address of the project (not a secret):
SUPABASE_URL=https://xzghsihffoliduqkjvck.supabase.co
# The project's SECRET key (Supabase dashboard -> Project Settings -> API Keys -> Secret keys, "sb_secret_…").
# It lets the API read and set families' plans and count their daily use. Never the publishable key, never in the app.
SUPABASE_SECRET_KEY=

# --- Optional selectable teacher voices (server only) -------------------------------------
# Qwen3 TTS Flash / Cherry. Use a pay-as-you-go key from the selected service.
# QwenCloud (maas.qwencloudapi.com): set QWEN_TTS_REGION=qwencloud; no Singapore choice needed.
# Alibaba Cloud Model Studio: use singapore (default) or beijing with a matching regional key.
DASHSCOPE_API_KEY=
QWEN_TTS_REGION=singapore
# GOOGLE_CLOUD_TTS_API_KEY is a Cloud TTS key, separate from the Gemini AI Studio key.
# Enable Cloud Text-to-Speech and billing; restrict the key to that API.
GOOGLE_CLOUD_TTS_API_KEY=
# Azure Neural uses AZURE_SPEECH_KEY and AZURE_SPEECH_REGION above.
