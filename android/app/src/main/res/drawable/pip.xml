<?xml version="1.0" encoding="utf-8"?>
<!--
  Pip, the app's mascot, drawn as Android vector art — the same drawing as the web app's icon (public/icon.svg).

  It is framed the way Android wants the front layer of a home-screen icon: a 108-unit square, of which only the
  middle 72 are certainly visible, because every launcher masks the icon to its own shape (circle, squircle, rounded
  square). So Pip is scaled to 0.63 and set at (16.2, 18) — the same framing as the web app's maskable icon
  (public/icon-maskable.svg), which puts ears and chin at 24 and 87, comfortably inside 18-90.

  Used three times: the front layer of the adaptive icon (mipmap-anydpi-v26/), the icon for Android 7 (mipmap/), and
  the launch screen (drawable/splash.xml). Change Pip in one place and all three follow.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.63"
        android:scaleY="0.63"
        android:translateX="16.2"
        android:translateY="18">

        <!-- Left ear, and the pink inside it. -->
        <path
            android:pathData="M 33,54 C 20,32 23,9 36,7 c 13,2 17,23 15,40 Z"
            android:fillColor="#6C4DF5" />
        <path
            android:pathData="M 36,46 c -7,-14 -6,-29 0.5,-31 C 43,17 45,31 44,42 Z"
            android:fillColor="#FF9BB0" />

        <!-- The right ear is the left one mirrored down the middle. -->
        <group
            android:scaleX="-1"
            android:translateX="120">
            <path
                android:pathData="M 33,54 C 20,32 23,9 36,7 c 13,2 17,23 15,40 Z"
                android:fillColor="#6C4DF5" />
            <path
                android:pathData="M 36,46 c -7,-14 -6,-29 0.5,-31 C 43,17 45,31 44,42 Z"
                android:fillColor="#FF9BB0" />
        </group>

        <!-- Head, then the lighter muzzle. -->
        <path
            android:pathData="M 24,74 a 36,34 0 1,0 72,0 a 36,34 0 1,0 -72,0 Z"
            android:fillColor="#6C4DF5" />
        <path
            android:pathData="M 38,86 a 22,17 0 1,0 44,0 a 22,17 0 1,0 -44,0 Z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.92" />

        <!-- Cheeks. -->
        <path
            android:pathData="M 30,79 a 5,5 0 1,0 10,0 a 5,5 0 1,0 -10,0 Z"
            android:fillColor="#FF6B5E"
            android:fillAlpha="0.55" />
        <path
            android:pathData="M 80,79 a 5,5 0 1,0 10,0 a 5,5 0 1,0 -10,0 Z"
            android:fillColor="#FF6B5E"
            android:fillAlpha="0.55" />

        <!-- Happy, closed eyes. -->
        <path
            android:pathData="M 39.5,67 Q 47,58 54.5,67"
            android:strokeColor="#2B2140"
            android:strokeWidth="3.6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 65.5,67 Q 73,58 80.5,67"
            android:strokeColor="#2B2140"
            android:strokeWidth="3.6"
            android:strokeLineCap="round" />

        <!-- Mouth. -->
        <path
            android:pathData="M 50,78 Q 60,95 70,78 Z"
            android:fillColor="#5A1E33" />
    </group>
</vector>
