{
  "name": "wunder-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "content:check": "vite-node scripts/content-check.ts",
    "server": "node server/index.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name wunder-tutor --branch main --commit-dirty=false",
    "cf:dev": "npm run build && wrangler pages dev dist --port 8788",
    "keys:check": "node scripts/push-keys.mjs --check",
    "keys:push": "node scripts/push-keys.mjs",
    "deploy:egress": "wrangler deploy -c egress/wrangler.toml",
    "i18n:export": "node scripts/i18n-export.mjs",
    "i18n:import": "node scripts/i18n-import.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:hans": "node scripts/i18n-hans.mjs",
    "build:app": "node scripts/build-app.mjs",
    "app:android": "npm run build:app && npx cap open android",
    "app:apk": "npm run build:app && node scripts/build-apk.mjs",
    "app:aab": "npm run build:app && node scripts/build-apk.mjs --play",
    "app:ios": "npm run build:app && npx cap open ios",
    "codes:new": "node scripts/invite-codes.mjs new",
    "codes:list": "node scripts/invite-codes.mjs list",
    "codes:off": "node scripts/invite-codes.mjs off",
    "contributions:pull": "node scripts/contributions-pull.mjs",
    "lessons:build": "node astra-lessons/build.mjs",
    "lessons:communication": "vite-node astra-lessons/build-communication.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@supabase/auth-js": "^2.116.0",
    "@supabase/postgrest-js": "^2.116.0",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "opencc-js": "^1.4.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
